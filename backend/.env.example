# Copy this file to .env in the backend/ directory to have these loaded
# automatically on startup (see app/config.py's load_dotenv() call).
# On Render, set these in the dashboard's Environment tab instead (see
# ../DEPLOYMENT.md) — a .env file only matters for local development.

# Comma-separated list of extra origins allowed to call this API, on top
# of the always-allowed localhost:5173 dev origin.
ALLOWED_ORIGINS=

# Optional — set this to get a real notification when a new fraud spike
# is detected (see app/services/alerting.py). Works with any endpoint
# that accepts a JSON POST: a Slack "Incoming Webhook" URL, a Discord
# channel webhook, ntfy.sh, or a Zapier/Make.com catch-hook. Leave blank
# to skip alerting entirely — GET /fraud-spikes still works normally
# either way, it just won't try to notify anyone.
ALERT_WEBHOOK_URL=
